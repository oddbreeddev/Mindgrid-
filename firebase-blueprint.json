{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Student information and preferences",
      "type": "object",
      "properties": {
        "full_name": { "type": "string", "description": "Student's full name" },
        "university": { "type": "string", "description": "Nigerian university name" },
        "department": { "type": "string", "description": "Academic department" },
        "bio": { "type": "string", "description": "Short student biography" },
        "photo_url": { "type": "string", "description": "Profile picture URL" },
        "selected_tech_track": { "type": "string", "description": "Chosen tech career path" },
        "updated_at": { "type": "string", "format": "date-time", "description": "Last profile update" }
      },
      "required": ["updated_at"]
    },
    "SocialPost": {
      "title": "Social Post",
      "description": "A post in the scholars feed",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "UID of the author" },
        "user_email": { "type": "string", "description": "Email of the author" },
        "content": { "type": "string", "description": "Post text content" },
        "created_at": { "type": "string", "format": "date-time", "description": "Time of posting" }
      },
      "required": ["user_id", "user_email", "content", "created_at"]
    },
    "Timetable": {
      "title": "Timetable",
      "description": "AI-generated study schedule",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "UID of the owner" },
        "goal": { "type": "string", "description": "Study goal" },
        "data": { "type": "object", "description": "The schedule JSON data" },
        "created_at": { "type": "string", "format": "date-time", "description": "Time of creation" }
      },
      "required": ["user_id", "goal", "data", "created_at"]
    },
    "CGPARecord": {
      "title": "CGPA Record",
      "description": "Semester GPA tracking",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "UID of the owner" },
        "semester_label": { "type": "string", "description": "Label for the semester" },
        "gpa": { "type": "number", "description": "GPA value" },
        "units": { "type": "integer", "description": "Total credit units" },
        "courses": { "type": "array", "description": "List of courses and grades" },
        "created_at": { "type": "string", "format": "date-time", "description": "Time of recording" }
      },
      "required": ["user_id", "semester_label", "gpa", "units", "courses", "created_at"]
    },
    "CuratedArticle": {
      "title": "Curated Article",
      "description": "AI-generated academic content",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Article title" },
        "excerpt": { "type": "string", "description": "Short summary" },
        "content": { "type": "string", "description": "Full markdown content" },
        "category": { "type": "string", "description": "Article category" },
        "author_name": { "type": "string", "description": "Author name" },
        "image_id": { "type": "string", "description": "Unsplash image ID" },
        "suggested_by": { "type": "string", "description": "User who suggested or wrote the topic" },
        "author_uid": { "type": "string", "description": "UID of the author for notifications" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Approval status" },
        "likes_count": { "type": "integer", "description": "Number of likes" },
        "created_at": { "type": "string", "format": "date-time", "description": "Time of publishing" }
      },
      "required": ["title", "content", "status", "created_at"]
    },
    "UserProgress": {
      "title": "User Progress",
      "description": "Tracks completed study topics",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "UID of the student" },
        "topic_id": { "type": "string", "description": "ID of the completed topic" },
        "category_id": { "type": "string", "description": "Category of the topic" },
        "created_at": { "type": "string", "format": "date-time", "description": "Time of completion" }
      },
      "required": ["user_id", "topic_id", "category_id", "created_at"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User alerts and updates",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "Recipient UID" },
        "title": { "type": "string", "description": "Alert title" },
        "message": { "type": "string", "description": "Alert content" },
        "type": { "type": "string", "enum": ["like", "new_article", "system"], "description": "Type of alert" },
        "read": { "type": "boolean", "description": "Read status" },
        "created_at": { "type": "string", "format": "date-time", "description": "Time of alert" }
      },
      "required": ["user_id", "title", "message", "type", "read", "created_at"]
    },
    "StudyRoom": {
      "title": "Study Room",
      "description": "A collaborative space for students, similar to a Discord server.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Room name" },
        "description": { "type": "string", "description": "Room purpose" },
        "owner_id": { "type": "string", "description": "UID of the creator" },
        "is_private": { "type": "boolean", "description": "Whether room is private" },
        "join_code": { "type": "string", "description": "Unique code to join" },
        "members": { "type": "array", "items": { "type": "string" }, "description": "List of member UIDs" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation time" }
      },
      "required": ["name", "owner_id", "join_code", "created_at"]
    },
    "RoomTopic": {
      "title": "Room Topic",
      "description": "A specific channel within a Study Room.",
      "type": "object",
      "properties": {
        "room_id": { "type": "string", "description": "Parent room ID" },
        "name": { "type": "string", "description": "Topic name (e.g. PHY 101)" },
        "description": { "type": "string", "description": "Topic description" },
        "created_at": { "type": "string", "format": "date-time", "description": "Creation time" }
      },
      "required": ["room_id", "name", "created_at"]
    },
    "TopicMessage": {
      "title": "Topic Message",
      "description": "Messages within a specific topic",
      "type": "object",
      "properties": {
        "topic_id": { "type": "string", "description": "Parent topic ID" },
        "user_id": { "type": "string", "description": "Sender UID" },
        "user_name": { "type": "string", "description": "Sender name" },
        "content": { "type": "string", "description": "Message text" },
        "is_ai": { "type": "boolean", "description": "Whether message is from Gemini" },
        "created_at": { "type": "string", "format": "date-time", "description": "Time of message" }
      },
      "required": ["topic_id", "user_id", "user_name", "content", "created_at"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Student profile documents"
    },
    "/social_posts/{postId}": {
      "schema": "SocialPost",
      "description": "Public social feed posts"
    },
    "/timetables/{timetableId}": {
      "schema": "Timetable",
      "description": "Personal study schedules"
    },
    "/cgpa_records/{recordId}": {
      "schema": "CGPARecord",
      "description": "Personal CGPA tracking records"
    },
    "/curated_articles/{articleId}": {
      "schema": "CuratedArticle",
      "description": "Public academic articles"
    },
    "/user_progress/{progressId}": {
      "schema": "UserProgress",
      "description": "Records of completed study topics"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User alerts"
    },
    "/study_rooms/{roomId}": {
      "schema": "StudyRoom",
      "description": "Discord-like study rooms"
    },
    "/study_rooms/{roomId}/topics/{topicId}": {
      "schema": "RoomTopic",
      "description": "Topics/Channels within a room"
    },
    "/study_rooms/{roomId}/topics/{topicId}/messages/{messageId}": {
      "schema": "TopicMessage",
      "description": "Chat messages within a topic"
    }
  }
}
